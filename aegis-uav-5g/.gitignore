# Generated experiment artifacts (kept out of git; reproducible from configs+seeds).
# The directory structure and .gitkeep files are tracked; heavy outputs are not.
artifacts/**/*.csv
artifacts/**/*.parquet
artifacts/**/*.json
artifacts/**/*.tex
artifacts/**/*.md
artifacts/**/*.png
artifacts/**/*.pdf
artifacts/**/*.svg
artifacts/**/*.joblib
artifacts/**/*.pkl
artifacts/**/*.log
!artifacts/**/.gitkeep

# Datasets (regenerated by the pipeline)
datasets/raw/**
datasets/interim/**
datasets/processed/**
datasets/manifests/*.json
!datasets/**/.gitkeep

