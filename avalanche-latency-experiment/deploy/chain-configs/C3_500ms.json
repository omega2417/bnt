// Chain config for profile C3_500ms.
// Install as ~/.avalanchego/configs/chains/<blockchainID>/config.json
// ACP-226: set the ProposerVM MinBlkDelay to 0 (see subnet config) so it
// does not override the dynamic minimum block time.
{
  "min-delay-target": 500,
  "allow-unfinalized-queries": false,
  "metrics-expensive-enabled": true,
  "log-json-format": true,
  "state-sync-enabled": false,
  "pruning-enabled": true,
  "commit-interval": 4096
}
