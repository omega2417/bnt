# Suricata 7.0 rules used by the baseline IDS-only arm and by the framework's
# network-evidence input. SIDs 9000001-9000099 are reserved for this study.

# S3: high-rate SYN toward the civil-service API.
alert tcp any any -> $EDGE_NET 8443 (msg:"DTCR S3 SYN flood toward civil-service API"; \
  flags:S,12; threshold:type both, track by_dst, count 800, seconds 5; \
  classtype:attempted-dos; sid:9000001; rev:2;)

# S3: connection-table pressure independent of rate.
alert tcp any any -> $EDGE_NET 8443 (msg:"DTCR S3 half-open connection pressure"; \
  flags:S,12; flow:not_established; threshold:type both, track by_dst, count 2000, seconds 10; \
  classtype:attempted-dos; sid:9000002; rev:1;)

# S1: control command from an identity outside the operator subnet.
alert tcp !$OPERATOR_NET any -> $EDGE_NET 6443 (msg:"DTCR S1 control-plane access from unexpected source"; \
  flow:established,to_server; classtype:attempted-admin; sid:9000010; rev:1;)

# S2: MQTT publish burst from a single client identity.
alert tcp any any -> $BROKER_NET 8883 (msg:"DTCR S2 anomalous MQTT publish rate"; \
  flow:established,to_server; threshold:type both, track by_src, count 400, seconds 5; \
  classtype:policy-violation; sid:9000020; rev:1;)

# S4: orchestration API call attempting a cross-domain placement.
alert tcp any any -> $CLOUD_NET 6443 (msg:"DTCR S4 orchestration API placement request"; \
  flow:established,to_server; content:"/apis/apps/v1/namespaces/dtcr/deployments"; http_uri; \
  classtype:policy-violation; sid:9000030; rev:1;)
