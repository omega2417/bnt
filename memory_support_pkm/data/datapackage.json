      "schema": {
        "fields": [
          {
            "name": "episode_id",
            "type": "string",
            "description": "Ідентифікатор епізоду",
            "constraints": {
              "required": true,
              "unique": true
            }
          },
          {
            "name": "participant_id",
            "type": "string",
            "description": "Посилання на participants",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "day",
            "type": "integer",
            "description": "День спостереження (0–27)",
            "constraints": {
              "minimum": 0
            }
          },
          {
            "name": "task_type",
            "type": "string",
            "description": "Тип завдання",
            "constraints": {
              "enum": [
                "medication_morning",
                "daily_walk",
                "appointment_prep",
                "bill_payment",
                "call_family"
              ]
            }
          },
          {
            "name": "category",
            "type": "string",
            "description": "Категорія даних для згоди"
          },
          {
            "name": "safety_critical",
            "type": "boolean",
            "description": "Завдання, критичне для безпеки"
          },
          {
            "name": "sensorable",
            "type": "boolean",
            "description": "Виконання може бути зафіксоване сенсором"
          },
          {
            "name": "scheduled",
            "type": "datetime",
            "description": "Запланований час (ISO 8601)"
          }
        ]
      }
    },
    {
