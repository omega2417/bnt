      "format": "csv",
      "description": "Персональна база подій: записи r_i = (c, t, s, κ, σ, v, e), рівняння (1)",
      "schema": {
        "fields": [
          {
            "name": "record_id",
            "type": "string",
            "description": "Ідентифікатор запису",
            "constraints": {
              "required": true,
              "unique": true
            }
          },
          {
            "name": "person_id",
            "type": "string",
            "description": "Чий це запис",
            "constraints": {
              "required": true
            }
          },
          {
            "name": "subject",
            "type": "string",
            "description": "Ідентичність події"
          },
          {
            "name": "content",
            "type": "string",
            "description": "c_i — зміст"
          },
          {
            "name": "time",
            "type": "datetime",
            "description": "t_i — час"
          },
          {
            "name": "source",
            "type": "string",
            "description": "s_i — джерело/походження (calendar, user_voice, sensor, call_log, carer_entry)"
          },
          {
            "name": "kappa",
            "type": "number",
            "description": "κ_i — індикатор довіри (не ймовірність)",
            "constraints": {
              "minimum": 0,
              "maximum": 1
