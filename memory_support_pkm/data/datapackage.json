    {
      "name": "reference_history",
      "path": "reference_history.csv",
      "format": "csv",
      "description": "Незалежна еталонна історія (ground truth) для сліпої оцінки тверджень",
      "schema": {
        "fields": [
          {
            "name": "person_id",
            "type": "string",
            "description": "Людина"
          },
          {
            "name": "subject",
            "type": "string",
            "description": "Подія"
          },
          {
            "name": "kind",
            "type": "string",
