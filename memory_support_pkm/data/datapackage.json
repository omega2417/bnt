          },
          {
            "name": "scope",
            "type": "string",
            "description": "σ_i — кому дозволено (через кому)"
          },
          {
            "name": "version",
            "type": "integer",
            "description": "v_i — версія",
            "constraints": {
              "minimum": 1
            }
          },
          {
            "name": "status",
            "type": "string",
            "description": "e_i — доказовий статус",
            "constraints": {
              "enum": [
                "plan",
                "self_report",
                "observation",
                "inference",
                "disputed"
              ]
            }
          },
          {
            "name": "category",
            "type": "string",
            "description": "Категорія даних"
          },
          {
            "name": "kind",
            "type": "string",
            "description": "Про що запис: scheduled / occurred / content",
            "constraints": {
              "enum": [
                "scheduled",
                "occurred",
                "content"
              ]
            }
          },
          {
            "name": "value",
            "type": "string",
            "description": "Нормалізоване значення твердження"
          },
          {
            "name": "supersedes",
            "type": "string",
            "description": "Попередня версія, яку замінює цей запис"
          },
          {
            "name": "active",
            "type": "boolean",
            "description": "Поточна версія"
          },
          {
            "name": "disputed",
            "type": "boolean",
            "description": "Позначено як спірний"
          }
        ]
      }
    },
