{
  "name": "pgmem-synthetic-memory-support",
  "title": "Синтетичний датасет для оцінювання provenance-governed асистента пам'яті",
  "version": "1.0.0",
  "licenses": [
    {
      "name": "CC-BY-4.0"
    }
  ],
  "description": "Повністю синтетичні дані, згенеровані за рамкою Prokopovych-Tkachenko «Provenance-governed agentic AI for personal knowledge and memory support» (етап 1 протоколу оцінювання). Жоден запис не відповідає реальній людині; розподіли — проєктні припущення, а не емпіричні оцінки.",
  "synthetic": true,
  "generator": {
    "package": "pgmem",
    "seed": 2026,
    "participants": 240,
    "days": 28
  },
  "resources": [
    {
      "name": "participants",
      "path": "participants.csv",
      "format": "csv",
      "description": "Учасники когорти та метадані, пов'язані з пам'яттю (одна стрічка = одна людина)",
      "schema": {
        "fields": [
          {
            "name": "participant_id",
            "type": "string",
            "description": "Псевдонімізований ідентифікатор",
            "constraints": {
              "required": true,
              "unique": true,
              "pattern": "P\\d{3}"
            }
          },
          {
            "name": "age",
            "type": "integer",
            "description": "Вік, роки",
            "constraints": {
              "minimum": 18,
              "maximum": 110
            }
          },
          {
            "name": "age_band",
            "type": "string",
            "description": "Вікова група",
            "constraints": {
              "enum": [
                "<50",
                "50-64",
                "65-74",
                "75-84",
                "85+"
              ]
            }
          },
          {
            "name": "sex",
            "type": "string",
            "description": "Стать",
            "constraints": {
              "enum": [
                "F",
                "M"
              ]
            }
          },
          {
            "name": "diagnosis",
            "type": "string",
            "description": "MCI — помірний когнітивний розлад; mild_dementia — легка деменція; ABI — набуте ураження мозку",
            "constraints": {
              "enum": [
                "MCI",
                "mild_dementia",
                "ABI"
              ]
            }
          },
          {
            "name": "cdr_global",
            "type": "number",
            "description": "Clinical Dementia Rating, глобальна оцінка (порожньо для ABI)",
            "constraints": {
              "minimum": 0,
              "maximum": 3
            }
          },
          {
            "name": "moca",
            "type": "integer",
            "description": "Montreal Cognitive Assessment з поправкою на освіту (0–30)",
            "constraints": {
              "minimum": 0,
              "maximum": 30
            }
          },
          {
            "name": "education_years",
            "type": "integer",
            "description": "Роки освіти",
            "constraints": {
              "minimum": 0,
              "maximum": 30
            }
          },
          {
            "name": "prmq_prospective",
            "type": "integer",
            "description": "PRMQ, проспективна шкала (8–40, більше = частіші збої)",
            "constraints": {
              "minimum": 8,
              "maximum": 40
            }
          },
          {
            "name": "prmq_retrospective",
            "type": "integer",
            "description": "PRMQ, ретроспективна шкала (8–40)",
            "constraints": {
              "minimum": 8,
              "maximum": 40
            }
          },
          {
            "name": "months_since_diagnosis",
            "type": "integer",
            "description": "Місяців від встановлення діагнозу",
            "constraints": {
              "minimum": 0
            }
          },
          {
            "name": "lives_alone",
            "type": "boolean",
            "description": "Живе сам(а)"
          },
          {
            "name": "has_trusted_person",
            "type": "boolean",
            "description": "Є погоджена довірена особа (R8)"
          },
          {
            "name": "trusted_relation",
            "type": "string",
            "description": "Хто довірена особа"
          },
          {
            "name": "device",
            "type": "string",
            "description": "Пристрій",
            "constraints": {
              "enum": [
                "smartphone",
                "tablet",
                "both"
              ]
            }
          },
          {
            "name": "digital_literacy",
            "type": "integer",
            "description": "Самооцінка цифрової грамотності (1–5)",
            "constraints": {
              "minimum": 1,
              "maximum": 5
            }
          },
          {
            "name": "uses_voice",
            "type": "boolean",
            "description": "Користується голосовою взаємодією (R6)"
          },
          {
            "name": "sensors_connected",
            "type": "boolean",
            "description": "Підключені сенсори (таблетниця, крокомір)"
          },
          {
            "name": "call_log_connected",
            "type": "boolean",
            "description": "Підключено журнал дзвінків"
          },
          {
            "name": "language",
            "type": "string",
            "description": "Мова інтерфейсу",
            "constraints": {
              "enum": [
                "uk",
                "en"
              ]
            }
          },
          {
            "name": "agrees_to_level_reduction",
            "type": "boolean",
            "description": "Згода на зниження стартового рівня підтримки (рівн. 3)"
          },
          {
            "name": "ability_latent",
            "type": "number",
            "description": "ЛИШЕ ДЛЯ СИМУЛЯЦІЇ: латентна здатність, з якої генеруються відповіді"
          }
        ]
      }
    },
    {
